[Unit]
Description=Meshtastic SAME/EAS BBS Backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/workspace/meshtastic/eas-alerter-backend
Environment=PYTHONUNBUFFERED=1
Environment=ALERT_CHANNEL_INDEX=1
Environment=DM_ONLY=true
Environment=AUTO_BROADCAST=true
ExecStart=/workspace/meshtastic/eas-alerter-backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure

[Install]
WantedBy=multi-user.target
